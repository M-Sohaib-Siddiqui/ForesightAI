# ===================================================================
# BUSINESS FORESIGHT - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# DO NOT ADD REAL SECRET KEYS TO THIS FILE.
# Copy this file to .env locally and fill in your actual credentials.
# ===================================================================

# Application Environment & Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Credentials (Database, pgvector, RLS, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# AI / LLM Provider Keys (Choose Gemini or OpenAI)
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Speech / Voice Provider Keys (Optional: Falls back to browser Web Speech API if unconfigured)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
